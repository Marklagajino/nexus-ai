# NEXUS — optional server-side provider keys.
#
# Any key set here is used automatically for that provider and never reaches
# the browser. You can also leave this file untouched and paste keys into the
# app's MODELS panel; those live only in the tab's session storage.
#
# Every provider below is OpenAI-compatible except Anthropic (Messages API)
# and Google (Gemini API) — the server translates for all three automatically.

ZAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Pollinations (anonymous free tier) needs no key and is selected automatically
# when nothing else is linked.
# Ollama runs locally without a key at http://localhost:11434/v1.

# Optional overrides for the Z.ai entry only:
# NEXUS_BASE_URL=https://api.z.ai/api/paas/v4
# NEXUS_MODEL=glm-4.6

# Server
PORT=3000
HOST=0.0.0.0
